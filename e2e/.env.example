# ============================================================================
# QuickCare E2E (Playwright) — Exemplo de Variáveis de Ambiente
# ============================================================================
# Copie este arquivo para:
#   - .env.local   (sobrescritas opcionais para o ambiente local)
#   - .env.remote  (credenciais opcionais para rodar @auth / @fluxo em produção)
#
# ATENÇÃO: Nunca faça commit de .env, .env.local ou .env.remote!
# ============================================================================

# Ambiente alvo: local | remote
TARGET_ENV=remote

# URLs (opcionais — já possuem defaults automáticos por TARGET_ENV)
# Local default : http://localhost:4200  | API: http://localhost:8080
# Remote default: https://quickcare-frontend.vercel.app | API: https://quickcare-backend-b4a4.onrender.com
# BASE_URL=https://quickcare-frontend.vercel.app
# API_URL=https://quickcare-backend-b4a4.onrender.com

# Credenciais para testes autenticados (@auth e @fluxo) no ambiente REMOTO
# (No ambiente LOCAL, os testes já usam automaticamente a massa seed R__massa_local.sql)
E2E_PATIENT_EMAIL=
E2E_PATIENT_PASSWORD=

E2E_PROFESSIONAL_EMAIL=
E2E_PROFESSIONAL_PASSWORD=

E2E_DUAL_EMAIL=
E2E_DUAL_PASSWORD=

E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Gravação de vídeo: retain-on-failure (padrão) | on (útil para gravar demo do TCC) | off
E2E_VIDEO=retain-on-failure
