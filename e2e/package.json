{
  "name": "quickcare-e2e-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Suíte isolada de testes End-to-End (E2E) do QuickCare com Playwright + TypeScript (Local e Remoto)",
  "scripts": {
    "test:01:remote": "cross-env TARGET_ENV=remote E2E_REPORT_DIR=relatorios/01-publico-e-navegacao playwright test tests/01-publico-e-navegacao.spec.ts",
    "test:02:remote": "cross-env TARGET_ENV=remote E2E_REPORT_DIR=relatorios/02-login-validacoes playwright test tests/02-login-validacoes.spec.ts",
    "test:03:remote": "cross-env TARGET_ENV=remote E2E_REPORT_DIR=relatorios/03-cadastro-validacoes-lgpd playwright test tests/03-cadastro-validacoes-lgpd.spec.ts",
    "test:04:remote": "cross-env TARGET_ENV=remote E2E_REPORT_DIR=relatorios/04-autenticacao-guards-perfis playwright test tests/04-autenticacao-guards-perfis.spec.ts",
    "test:05:remote": "cross-env TARGET_ENV=remote E2E_REPORT_DIR=relatorios/05-jornada-completa-multiusuario playwright test tests/05-jornada-completa-multiusuario.spec.ts",
    "test:06:remote": "cross-env TARGET_ENV=remote E2E_REPORT_DIR=relatorios/06-perfil-publico-profissional playwright test tests/06-perfil-publico-profissional.spec.ts",
    "test:07:remote": "cross-env TARGET_ENV=remote E2E_REPORT_DIR=relatorios/07-recuperacao-senha-e-conta playwright test tests/07-recuperacao-senha-e-conta.spec.ts",
    "test:08:remote": "cross-env TARGET_ENV=remote E2E_REPORT_DIR=relatorios/08-paciente-validacao-edicao-solicitacao playwright test tests/08-paciente-validacao-edicao-solicitacao.spec.ts",
    "test:09:remote": "cross-env TARGET_ENV=remote E2E_REPORT_DIR=relatorios/09-paciente-recusa-proposta playwright test tests/09-paciente-recusa-proposta.spec.ts",
    "test:10:remote": "cross-env TARGET_ENV=remote E2E_REPORT_DIR=relatorios/10-paciente-historico-e-busca-profissionais playwright test tests/10-paciente-historico-e-busca-profissionais.spec.ts",
    "test:11:remote": "cross-env TARGET_ENV=remote E2E_REPORT_DIR=relatorios/11-paciente-meu-perfil-e-documentos playwright test tests/11-paciente-meu-perfil-e-documentos.spec.ts",
    "test:12:remote": "cross-env TARGET_ENV=remote E2E_REPORT_DIR=relatorios/12-paciente-seguranca-notificacoes-novo-perfil playwright test tests/12-paciente-seguranca-notificacoes-novo-perfil.spec.ts",
    "test:13:remote": "cross-env TARGET_ENV=remote E2E_REPORT_DIR=relatorios/13-profissional-gestao-propostas playwright test tests/13-profissional-gestao-propostas.spec.ts",
    "test:14:remote": "cross-env TARGET_ENV=remote E2E_REPORT_DIR=relatorios/14-profissional-historico-e-perfil-paciente playwright test tests/14-profissional-historico-e-perfil-paciente.spec.ts",
    "test:15:remote": "cross-env TARGET_ENV=remote E2E_REPORT_DIR=relatorios/15-profissional-meu-perfil-e-atuacoes playwright test tests/15-profissional-meu-perfil-e-atuacoes.spec.ts",
    "test:16:remote": "cross-env TARGET_ENV=remote E2E_REPORT_DIR=relatorios/16-profissional-documentos-e-seguranca playwright test tests/16-profissional-documentos-e-seguranca.spec.ts",
    "test:17:remote": "cross-env TARGET_ENV=remote E2E_REPORT_DIR=relatorios/17-chat-central-e-recursos-avancados playwright test tests/17-chat-central-e-recursos-avancados.spec.ts",
    "test:18:remote": "cross-env TARGET_ENV=remote E2E_REPORT_DIR=relatorios/18-admin-fila-e-dossies-validacao playwright test tests/18-admin-fila-e-dossies-validacao.spec.ts",
    "test:19:remote": "cross-env TARGET_ENV=remote E2E_REPORT_DIR=relatorios/19-admin-disputas-denuncias-ocorrencias playwright test tests/19-admin-disputas-denuncias-ocorrencias.spec.ts",
    "test:20:remote": "cross-env TARGET_ENV=remote E2E_REPORT_DIR=relatorios/20-admin-consultas-gerais-auditoria playwright test tests/20-admin-consultas-gerais-auditoria.spec.ts",
    "test:local": "cross-env TARGET_ENV=local playwright test",
    "test:local:smoke": "cross-env TARGET_ENV=local playwright test --grep @smoke",
    "test:local:headed": "cross-env TARGET_ENV=local E2E_SLOW_MO=500 playwright test --headed",
    "test:local:ui": "cross-env TARGET_ENV=local playwright test --ui",
    "test:remote": "cross-env TARGET_ENV=remote playwright test --grep @smoke",
    "test:remote:auth": "cross-env TARGET_ENV=remote playwright test --grep \"@smoke|@auth\"",
    "test:remote:full": "cross-env TARGET_ENV=remote playwright test",
    "test:remote:headed": "cross-env TARGET_ENV=remote E2E_SLOW_MO=500 playwright test --grep @smoke --headed",
    "test:remote:ui": "cross-env TARGET_ENV=remote playwright test --ui",
    "test:record:local": "cross-env TARGET_ENV=local E2E_VIDEO=on playwright test",
    "test:record:remote": "cross-env TARGET_ENV=remote E2E_VIDEO=on playwright test --grep @smoke",
    "report": "playwright show-report",
    "report:01": "playwright show-report relatorios/01-publico-e-navegacao/html-report",
    "report:02": "playwright show-report relatorios/02-login-validacoes/html-report",
    "report:03": "playwright show-report relatorios/03-cadastro-validacoes-lgpd/html-report",
    "report:04": "playwright show-report relatorios/04-autenticacao-guards-perfis/html-report",
    "report:05": "playwright show-report relatorios/05-jornada-completa-multiusuario/html-report",
    "report:06": "playwright show-report relatorios/06-perfil-publico-profissional/html-report",
    "report:07": "playwright show-report relatorios/07-recuperacao-senha-e-conta/html-report",
    "report:08": "playwright show-report relatorios/08-paciente-validacao-edicao-solicitacao/html-report",
    "report:09": "playwright show-report relatorios/09-paciente-recusa-proposta/html-report",
    "report:10": "playwright show-report relatorios/10-paciente-historico-e-busca-profissionais/html-report",
    "report:11": "playwright show-report relatorios/11-paciente-meu-perfil-e-documentos/html-report",
    "report:12": "playwright show-report relatorios/12-paciente-seguranca-notificacoes-novo-perfil/html-report",
    "report:13": "playwright show-report relatorios/13-profissional-gestao-propostas/html-report",
    "report:14": "playwright show-report relatorios/14-profissional-historico-e-perfil-paciente/html-report",
    "report:15": "playwright show-report relatorios/15-profissional-meu-perfil-e-atuacoes/html-report",
    "report:16": "playwright show-report relatorios/16-profissional-documentos-e-seguranca/html-report",
    "report:17": "playwright show-report relatorios/17-chat-central-e-recursos-avancados/html-report",
    "report:18": "playwright show-report relatorios/18-admin-fila-e-dossies-validacao/html-report",
    "report:19": "playwright show-report relatorios/19-admin-disputas-denuncias-ocorrencias/html-report",
    "report:20": "playwright show-report relatorios/20-admin-consultas-gerais-auditoria/html-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^20.17.24",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.3"
  }
}
