# Ambiente alvo: local | remote
# NOTA DE SEGURANCA: Carga (NF-02), Estresse (NF-03) e Recuperacao (NF-08)
# sao bloqueados automaticamente contra o ambiente remoto para proteger Render/Vercel.
TEST_ENV=local

# URLs Locais (padrao quando TEST_ENV=local)
LOCAL_FRONTEND_URL=http://localhost:4200
LOCAL_BACKEND_URL=http://localhost:8080

# URLs Remotas (usadas quando TEST_ENV=remote nas suites nao-destrutivas)
REMOTE_FRONTEND_URL=https://quickcare-frontend.vercel.app
REMOTE_BACKEND_URL=https://quickcare-backend-b4a4.onrender.com

# Credenciais Locais (seed de desenvolvimento R__massa_local.sql)
LOCAL_PATIENT_EMAIL=paciente@quickcare.dev
LOCAL_PATIENT_PASSWORD=Senha@123
LOCAL_PATIENT_B_EMAIL=maria@quickcare.dev
LOCAL_PATIENT_B_PASSWORD=Senha@123
LOCAL_PROFESSIONAL_EMAIL=profissional@quickcare.dev
LOCAL_PROFESSIONAL_PASSWORD=Senha@123
LOCAL_DUAL_EMAIL=ambos@quickcare.dev
LOCAL_DUAL_PASSWORD=Senha@123
LOCAL_ADMIN_EMAIL=admin@quickcare.dev
LOCAL_ADMIN_PASSWORD=Senha@123

# Credenciais Remotas (preencher em .env.remote local, nunca versionado)
E2E_PATIENT_EMAIL=
E2E_PATIENT_PASSWORD=
E2E_PROFESSIONAL_EMAIL=
E2E_PROFESSIONAL_PASSWORD=
E2E_DUAL_EMAIL=
E2E_DUAL_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
