{
  "name": "quickcare-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "cy:open": "node cypress/cypress-cli.mjs open --e2e --browser chrome",
    "cy:run": "node cypress/cypress-cli.mjs run --e2e",
    "e2e": "start-server-and-test start http://localhost:4200 cy:run",
    "e2e:open": "start-server-and-test start http://localhost:4200 cy:open",
    "demo:cy:open": "node cypress/cypress-cli.mjs open --e2e --browser chrome --config-file cypress.demo.config.ts",
    "demo:cy:run": "node cypress/cypress-cli.mjs run --e2e --browser chrome --no-runner-ui --config-file cypress.demo.config.ts",
    "demo": "start-server-and-test start http://localhost:4200 demo:cy:run",
    "demo:open": "start-server-and-test start http://localhost:4200 demo:cy:open"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@stomp/stompjs": "^7.0.0",
    "@vercel/flags-core": "^1.11.1",
    "cropperjs": "^1.6.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.0",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "cypress": "^13.17.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "start-server-and-test": "^3.0.13",
    "typescript": "~5.7.2"
  }
}
